# Required by scripts/upload-market.py.
COS_SECRET_ID=
COS_SECRET_KEY=
# Full bucket name, including APPID. Example: octop-download-1250000000
COS_BUCKET=
# Bucket region. Example: ap-guangzhou
COS_REGION=ap-guangzhou
# Optional. Default is ${COS_BUCKET}.cos.${COS_REGION}.myqcloud.com.
# From a Tencent Cloud VPC, set ${COS_BUCKET}.cos-internal.${COS_REGION}.tencentcos.cn
COS_ENDPOINT=

# Optional. Required only when using temporary credentials.
COS_SESSION_TOKEN=

# CDN PurgePathCache runs after a successful upload.
# https://cloud.tencent.com/document/product/228/37871
# Set to 0 to upload without refreshing the CDN.
CDN_PURGE=1
# Optional. Defaults to COS_SECRET_ID / COS_SECRET_KEY / COS_SESSION_TOKEN.
CDN_SECRET_ID=
CDN_SECRET_KEY=
CDN_SESSION_TOKEN=
# flush refreshes changed objects. delete drops every cached object in the directory.
CDN_FLUSH_TYPE=flush
# Optional: mainland or overseas. Empty follows the domain acceleration area.
CDN_PURGE_AREA=
# Required when CDN purge is enabled. Comma-separated directory URLs, each ending with /.
CDN_PURGE_PATHS=
